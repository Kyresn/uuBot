# `.env` 只放引导项：网页监听与登录、目录位置。
# 其余运行期配置全部在 config/harness.json，在网页「设置」页编辑、保存即热生效。
# 模型端点不在这里：它们只来自 config/models.json（M2.5 起）。
# 例外只有三个仍只从 env 读取的键：QQ_ACCOUNT（compose 给 NapCat 登录用）
# 与两个控制面 TTL（不在 harness.json schema 里）。
#
# 迁移规则（最容易踩的一点）：
#   harness.json 不存在时，首次启动会把旧 env 里的 QQ_* / TICK_* /
#   WAKE_DEBOUNCE_MS / HTTP_TIMEOUT_MS / REDLINE_FALLBACK_TEXT 导入一次并落盘；
#   之后 harness.json 存在，这些环境变量一律被忽略，改 .env 不再生效。
#   两处都配时以 config/harness.json 为准；启动日志会打印
#   「QQ config comes from harness.json; QQ_* env is ignored」。

# 网页控制台的登录 token，至少 32 字符。生成命令：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEB_CONSOLE_TOKEN=
# 网页监听端口，默认 3080；docker compose 中容器内外使用同一个端口
WEB_PORT=
# 网页监听地址，默认 127.0.0.1
WEB_HOST=
# 允许绑定非 loopback 地址（1/true/yes）；前面必须有 TLS 反向代理
WEB_ALLOW_REMOTE=
# TLS 反代场景：会话 cookie 加 Secure
WEB_COOKIE_SECURE=
# 反向代理的额外 Host/Origin 白名单，逗号分隔的 host[:port]
WEB_ALLOWED_HOSTS=
# 仅在反代确实覆盖 X-Forwarded-For 时启用登录限速取真实来源
WEB_TRUSTED_PROXY=
# 配置目录：models.json 与 harness.json 的位置，默认 ./config
CONFIG_DIR=
# 运行期状态目录：对话记录、审批、审计，默认 ./state
DATA_DIR=

# NapCat 登录用的 QQ 号；只给 deploy/docker-compose.yml 的 napcat 服务插值，
# harness 侧的 QQ 参数在 config/harness.json（不读这个键）
QQ_ACCOUNT=
# 控制指令二次确认 TTL（毫秒，默认 60000）；仍只从 env 读取
CONTROL_CONFIRM_TTL_MS=
# 其余人工审批的默认 TTL（毫秒，默认 600000）；仍只从 env 读取
CONTROL_APPROVAL_TTL_MS=
